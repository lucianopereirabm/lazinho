rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Administrador principal (Luciano)
    function logado() { return request.auth != null; }
    function isAdmin() { return logado() && request.auth.uid == 'z0MjWvFOXqUqWPS2I0vD6mBxOOR2'; }
    // Vendedor ligado a este login (cadastrado pela Gestão em "usuarios")
    function isVendedor() { return logado() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid)); }
    function meuVendedor() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.vendedorId; }
    // Permissões do vendedor (definidas pela Gestão no cadastro do usuário)
    function perm(nome, padrao) { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data.get(nome, padrao) == true; }

    match /usuarios/{uid} { allow read: if isAdmin() || (logado() && request.auth.uid == uid); allow write: if isAdmin(); }

    // Cadastros e carga do Portal: vendedor lê, só administrador altera
    match /vendedores/{id} { allow read: if isAdmin() || isVendedor(); allow write: if isAdmin(); }
    match /clientes/{id}   { allow read: if isAdmin() || isVendedor(); allow write: if isAdmin(); }
    match /produtos/{id}   { allow read: if isAdmin() || isVendedor(); allow write: if isAdmin(); }
    match /condicoes/{id}  { allow read: if isAdmin() || isVendedor(); allow write: if isAdmin(); }
    match /resumo/{id}     { allow read: if isAdmin() || isVendedor(); allow write: if isAdmin(); }
    match /config/{id}     { allow read: if isAdmin() || isVendedor(); allow write: if isAdmin(); }

    // Pedidos: o vendedor cria e enxerga só os próprios; só cancela enquanto "novo"
    match /pedidos/{id} {
      allow read: if isAdmin() || (isVendedor() && resource.data.vendedorId == meuVendedor());
      allow create: if isAdmin() || (isVendedor() && perm('permPedido', true)
        && request.resource.data.vendedorId == meuVendedor()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'novo');
      // Enquanto "novo" o vendedor pode editar ou cancelar; depois que a Lazinho recebe (importa), só a Gestão altera
      allow update: if isAdmin() || (isVendedor() && perm('permPedido', true)
        && resource.data.vendedorId == meuVendedor()
        && resource.data.status == 'novo'
        && request.resource.data.status in ['novo', 'cancelado']
        && request.resource.data.vendedorId == resource.data.vendedorId
        && request.resource.data.uid == resource.data.uid);
      allow delete: if isAdmin();
    }

    // Visitas: o vendedor cria e enxerga só as próprias; só a Gestão altera ou apaga
    match /visitas/{id} {
      allow read: if isAdmin() || (isVendedor() && resource.data.vendedorId == meuVendedor());
      allow create: if isAdmin() || (isVendedor() && perm('permVisita', true)
        && request.resource.data.vendedorId == meuVendedor()
        && request.resource.data.uid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // Clientes cadastrados pelo vendedor no app (só quem tem permissão); a Gestão leva ao Portal
    match /clientesNovos/{id} {
      allow read: if isAdmin() || (isVendedor() && resource.data.vendedorId == meuVendedor());
      allow create: if isAdmin() || (isVendedor() && perm('permCliente', false)
        && request.resource.data.vendedorId == meuVendedor()
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.status == 'novo');
      allow update, delete: if isAdmin();
    }

    // Todo o resto: bloqueado
    match /{document=**} { allow read, write: if false; }
  }
}
